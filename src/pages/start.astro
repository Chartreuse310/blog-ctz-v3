---
import BaseLayout from '../layouts/BaseLayout.astro';
import { sitePath } from '../lib/urls';
import Icon from '../components/chrome/Icon.astro';
import { getPublishedWriting } from '../lib/content';
const writing=await getPublishedWriting();
const paths=[
  {title:'J人',description:'沿着一条有顺序的路径，那么请从我的专栏开始。',href:'/columns/'},
  {title:'P人',description:'从标签开始，在不同年份和专栏之间横向移动。',href:'/tags/'},
  {title:'?人',description:'我就想找到那篇文章——搜索标题、摘要、正文和标签。',href:'/search/'},
];
---
<BaseLayout title="开始 · Fourfold"><header class="page-head container"><p class="eyebrow">Start here</p><h1>从哪里开始？</h1><p>如果你迷路了——这里是几条更容易走进去的阅读路径。</p></header><section class="container paths">{paths.map((path,index)=><a href={sitePath(path.href)}><span>0{index+1}</span><div><h2>{path.title}</h2><p>{path.description}</p></div><b><Icon name="arrowRight" /></b></a>)}</section><p class="container muted">目前有 {writing.length} 篇写作，持续增加中。</p></BaseLayout>
<style>.page-head{padding:5rem 0 3rem}.page-head h1{font-size:clamp(3rem,8vw,6rem);line-height:.95;letter-spacing:-.07em;max-width:55rem;margin:.5rem 0}.page-head p{color:var(--muted)}.paths a{display:grid;grid-template-columns:4rem 1fr auto;gap:1rem;align-items:center;padding:1.5rem 0;border-top:1px solid var(--line);text-decoration:none}.paths a:last-child{border-bottom:1px solid var(--line)}.paths span{color:var(--accent);font:700 .8rem ui-monospace,monospace}.paths h2{margin:0;font-size:1.7rem}.paths p{margin:.1rem 0;color:var(--muted)}.paths b{font-size:1.5rem;color:var(--accent)}</style>
