---
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
export async function getStaticPaths(){ const {getCollection}=await import('astro:content'); const entries=await getCollection('design',({data})=>!data.draft); return entries.map((entry)=>({params:{slug:entry.data.slug},props:{entry}})); }
const {entry}=Astro.props;
const gallerySizes='(max-width: 42rem) 100vw, 568px';
---
<BaseLayout title={`${entry.data.title} · Fourfold`} description={entry.data.description} canonical={entry.data.canonical} image={entry.data.ogImage ?? entry.data.cover?.src}>
  <header class="page-head container">
    <p class="eyebrow">Gallery</p>
    <h1>{entry.data.title}</h1>
    <p>{entry.data.description}</p>
  </header>
  <section class="container gallery">
    {entry.data.photos.map((photo, index) => <figure>
      <Image src={photo.src} alt={photo.alt} format="webp" widths={[600, 1200]} sizes={gallerySizes} quality={78} loading={index === 0 ? 'eager' : 'lazy'} decoding="async" />
      {photo.caption && <figcaption>{photo.caption}</figcaption>}
    </figure>)}
  </section>
</BaseLayout>
<style>.page-head{padding:5rem 0 3rem}.page-head h1{font-size:clamp(3rem,8vw,6rem);line-height:.95;letter-spacing:-.07em;margin:.5rem 0}.page-head p{color:var(--muted)}.gallery{display:grid;grid-template-columns:repeat(2,1fr);gap:1rem}.gallery figure{margin:0}.gallery img{width:100%;height:auto;display:block}.gallery figcaption{font-size:.8rem;color:var(--muted);padding:.5rem 0}@media(max-width:42rem){.gallery{grid-template-columns:1fr}}</style>
